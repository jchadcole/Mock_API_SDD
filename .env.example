# Postman API key (Account Settings -> API Keys in Postman).
# Shared team-wide key used by the backend to talk to the Postman API.
POSTMAN_API_KEY=

# Postman workspace ID that new specs/collections/mocks should be created in.
# Find it in the workspace URL: https://go.postman.co/workspace/<POSTMAN_WORKSPACE_ID>/overview
POSTMAN_WORKSPACE_ID=

# Backend server port
PORT=4000

# Prisma / SQLite database location (relative to apps/api/prisma, where schema.prisma lives)
DATABASE_URL="file:./dev.db"

# How often (in minutes) the drift checker job should run. Set to 0 to disable the scheduler.
DRIFT_CHECK_INTERVAL_MINUTES=30

# Base URL the web app uses to reach the API (used by apps/web in dev)
VITE_API_BASE_URL=http://localhost:4000
